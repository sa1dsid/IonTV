<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev-бэкенд пока доступен только по IP с самоподписанным сертификатом. Доверяем
         ровно этому сертификату и только для этого адреса; остальные хосты проверяются
         системными CA как обычно. Убрать вместе с переездом на домен. -->
    <domain-config>
        <domain includeSubdomains="false">2.28.124.251</domain>
        <trust-anchors>
            <certificates src="@raw/iontv_dev_server" />
        </trust-anchors>
    </domain-config>
</network-security-config>
