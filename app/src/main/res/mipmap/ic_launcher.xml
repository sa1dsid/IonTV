<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 без адаптивных иконок: та же планета на чёрном круге. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <bitmap android:src="@drawable/img_planet" />
    </item>
</layer-list>
