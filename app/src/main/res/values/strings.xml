<?xml version="1.0" encoding="utf-8"?>
<!-- IONTV · строки интерфейса (EN). Бренды не переводятся: IONTV, IO Aura, Data Share. -->
<resources>
    <string name="app_name" translatable="false">IONTV</string>

    <!-- Вордмарк I(планета)NTV: буква O — картинка планеты. -->
    <string name="brand_i" translatable="false">I</string>
    <string name="brand_ntv" translatable="false">NTV</string>

    <!-- Нет связи: заставка и экран входа повторяют сами, кнопок нет. -->
    <string name="no_connection_retrying">No connection · retrying…</string>

    <!-- 2 · Вход: QR и код вводятся в IO Aura на телефоне -->
    <string name="signin_title">Link this TV to your account</string>
    <string name="signin_how">Open &lt;b&gt;IO Aura&lt;/b&gt; on your phone → &lt;b&gt;Devices&lt;/b&gt; → &lt;b&gt;Add TV&lt;/b&gt; and scan the code. Manual code entry is there too.</string>
    <string name="signin_enter_code">or enter code</string>
    <string name="signin_code_expired">Code expired</string>
    <string name="signin_refresh">Refresh</string>
    <string name="signin_google">Continue with Google</string>
    <string name="signin_or">OR</string>
    <string name="signin_email">Sign in with email</string>

    <!-- 2b · Вход по почте: у IONTV вход без пароля, по коду из письма -->
    <string name="email_title">Sign in with email</string>
    <string name="email_label">EMAIL</string>
    <string name="email_placeholder">you@example.com</string>
    <string name="email_send_code">Send code</string>
    <string name="email_code_label">CODE</string>
    <string name="email_code_placeholder">6-digit code from the email</string>
    <string name="email_sign_in">Sign in</string>
    <string name="email_resend">Resend code</string>
    <string name="email_resend_in">Resend in %1$ds</string>
    <string name="email_error_invalid">Invalid email format</string>
    <string name="email_error_code">Invalid or expired code · request a new one</string>
    <string name="email_error_too_soon">Too soon · wait a minute before asking for a new code</string>

    <!-- 3/3b · Согласие на Data Share: юртекст — финал терминального консента IO Aura -->
    <string name="consent_title">Data Share on this TV</string>
    <string name="consent_text">I allow IONTV to use part of this device’s internet channel for analytical tests in the interests of the service’s partners. The device acts as an access point for data processing via a secured API: no personal data is collected, traffic is anonymized. I can turn this off or delete the account with all data at any time in IO Aura settings.</string>
    <string name="consent_agree">Agree &amp; continue</string>
    <string name="consent_decline">Decline</string>
    <string name="consent_legal">By continuing you agree to the &lt;b&gt;Terms of Service&lt;/b&gt; and &lt;b&gt;Privacy Policy&lt;/b&gt;.</string>
    <string name="consent_legal_scan">Scan to read on your phone · %1$s</string>
    <string name="consent_decline_title">Without Data Share this TV can’t work</string>
    <string name="consent_decline_text">Sharing is what IONTV does. You can agree anytime — nothing is lost.</string>
    <string name="consent_go_back">Go back</string>
    <string name="consent_exit">Exit app</string>

    <!-- 4a–4c · Настройка: галки ставит проверка системы, а не пользователь -->
    <string name="setup_title">Complete both steps to start sharing</string>
    <string name="setup_background">Allow background activity</string>
    <string name="setup_autostart">Allow autostart on boot</string>
    <string name="setup_open_settings">OPEN SETTINGS →</string>
    <string name="setup_done">DONE</string>
    <string name="setup_continue">Continue</string>

    <!-- Уведомление сервиса раздачи: телевизоры его обычно не показывают -->
    <string name="sharing_notification_channel">Data Share</string>
    <string name="sharing_notification_text">Data Share is running</string>

    <!-- Ошибки входа — строкой на месте; тексты из Auth IO Aura -->
    <string name="error_no_connection">No connection · check your network</string>
    <string name="error_server">Server is not responding · try again later</string>
    <string name="error_google_unavailable">Google sign-in is unavailable · try email</string>
</resources>
